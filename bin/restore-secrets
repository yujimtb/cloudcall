#!/bin/sh
# Download the encrypted bundle from the private secrets repo and restore it into this kit.
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
. "$ROOT/lib/common.sh"
REPO="${CLOUDCALL_SECRETS_REPO:-$(gh api user -q .login)/cloudcall-secrets}"
WORK="$STATE/secrets-repo"
if [ -e "$CALL_ENV" ] && [ "${1:-}" != "--force" ]; then
    echo "$CALL_ENV already exists; rerun with --force to overwrite." >&2
    exit 1
fi
pgrep -f "^$VENDOR/jami/usr/bin/jami" >/dev/null && { echo "Quit Jami before restoring." >&2; exit 1; }
rm -rf "$WORK"
mkdir -p "$STATE"
gh repo clone "$REPO" "$WORK" -- --quiet --depth 1
echo "Enter the backup passphrase:"
openssl enc -d -aes-256-cbc -pbkdf2 -iter 600000 -in "$WORK/cloudcall-secrets.tar.gz.enc" | tar -xzf - -C "$ROOT"
rm -rf "$WORK"
chmod -R go-rwx "$PRIVATE" "$STATE/jami" 2>/dev/null || true
echo "Restored secrets into $ROOT"
