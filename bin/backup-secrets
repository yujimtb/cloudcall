#!/bin/sh
# Encrypt private/ (relay secrets, Cloudflare token) and the Jami account data with a passphrase,
# then push the bundle to a PRIVATE GitHub repo (default: <your-gh-user>/cloudcall-secrets).
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
. "$ROOT/lib/common.sh"
REPO="${CLOUDCALL_SECRETS_REPO:-$(gh api user -q .login)/cloudcall-secrets}"
WORK="$STATE/secrets-repo"
cd "$ROOT"
set --
for path in private state/jami/data/jami state/jami/config/jami; do
    [ -e "$path" ] && set -- "$@" "$path"
done
[ $# -gt 0 ] || { echo "Nothing to back up." >&2; exit 1; }
pgrep -f "^$VENDOR/jami/usr/bin/jami" >/dev/null && echo "Note: Jami is running; quit it first for a fully consistent backup."
if ! gh repo view "$REPO" >/dev/null 2>&1; then
    gh repo create "$REPO" --private --description "Encrypted CloudCall secrets" >/dev/null
    echo "Created private repo $REPO"
fi
[ "$(gh repo view "$REPO" --json isPrivate -q .isPrivate)" = true ] || { echo "$REPO is not private; refusing to push." >&2; exit 1; }
rm -rf "$WORK"
gh repo clone "$REPO" "$WORK" -- --quiet 2>/dev/null || { mkdir -p "$WORK" && git -C "$WORK" init -q -b main && git -C "$WORK" remote add origin "https://github.com/$REPO.git"; }
echo "Choose a strong passphrase (you need it to restore):"
tar -czf - "$@" | openssl enc -aes-256-cbc -pbkdf2 -iter 600000 -salt -out "$WORK/cloudcall-secrets.tar.gz.enc"
printf 'Encrypted CloudCall secrets. Restore with bin/restore-secrets from https://github.com/yujimtb/cloudcall\n' >"$WORK/README.md"
git -C "$WORK" add README.md cloudcall-secrets.tar.gz.enc
git -C "$WORK" commit -q -m "Update encrypted CloudCall secrets ($(date -u +%Y-%m-%dT%H:%MZ))"
git -C "$WORK" push -q -u origin HEAD:main
rm -rf "$WORK"
echo "Pushed encrypted bundle to https://github.com/$REPO"
